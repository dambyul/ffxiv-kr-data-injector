<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:FFXIVInjector.UI.ViewModels"
        xmlns:core="using:FFXIVInjector.Core"
        xmlns:services="using:FFXIVInjector.UI.Services"
        xmlns:conv="using:FFXIVInjector.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="650"
        Width="600" SizeToContent="Height"
        MinWidth="600" MaxWidth="600"
        WindowStartupLocation="CenterScreen"
        CanResize="False"
        x:Class="FFXIVInjector.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Title="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[App.Title]}"
        SystemDecorations="Full"
        ExtendClientAreaToDecorationsHint="True">

    <Window.Resources>
        <conv:EnumToBoolConverter x:Key="EnumToBool"/>
        <conv:LanguageDisplayConverter x:Key="LanguageDisplayConverter"/>
        <conv:BoolToValueConverter x:Key="ProgressColorConverter" TrueValue="#D32F2F" FalseValue="{DynamicResource SystemAccentColor}"/>
        <conv:BoolToValueConverter x:Key="VersionBorderConverter" TrueValue="#E7A33E" FalseValue="Transparent"/>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="Button.headerLink">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="7"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="ToggleButton#LogToggle">
            <Setter Property="RenderTransformOrigin" Value="50%,50%" />
            <Setter Property="RenderTransform" Value="none" />
        </Style>
        <Style Selector="ToggleButton#LogToggle:checked">
            <Setter Property="RenderTransform" Value="rotate(180deg)" />
        </Style>
        <Style Selector="ToggleButton#LogToggle:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton#LogToggle:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style Selector="ToggleButton#LogToggle:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto, Auto, Auto, Auto" Margin="25">
        
        <!-- Row 0: Header Section -->
        <Grid Grid.Row="0" Margin="0,10,0,25" ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                <TextBlock
                       Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Header.Title]}"
                       FontSize="26" FontWeight="Bold" VerticalAlignment="Center"/>
                <Button Command="{Binding OpenGitHubCommand}"
                        Background="Transparent" Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        BorderBrush="{Binding HasReleaseMismatch, Converter={StaticResource VersionBorderConverter}}"
                        BorderThickness="1" CornerRadius="4" Padding="5,1" FontSize="12"
                        HorizontalAlignment="Left" Cursor="Hand"
                        ToolTip.Tip="{Binding ReleaseNotice}">
                    <TextBlock Text="{Binding AppVersionLabel}"/>
                </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" Margin="12,0,0,0"
                        VerticalAlignment="Center">
                <Button Command="{Binding OpenDiscordCommand}" Classes="headerLink"
                        ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Link.Discord]}"
                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Link.Discord]}">
                    <!-- Discord mark: Simple Icons (CC0). -->
                    <Viewbox Width="22" Height="22" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M20.317 4.3698a19.7913 19.7913 0 00-4.8851-1.5152.0741.0741 0 00-.0785.0371c-.211.3753-.4447.8648-.6083 1.2495-1.8447-.2762-3.68-.2762-5.4868 0-.1636-.3933-.4058-.8742-.6177-1.2495a.077.077 0 00-.0785-.037 19.7363 19.7363 0 00-4.8852 1.515.0699.0699 0 00-.0321.0277C.5334 9.0458-.319 13.5799.0992 18.0578a.0824.0824 0 00.0312.0561c2.0528 1.5076 4.0413 2.4228 5.9929 3.0294a.0777.0777 0 00.0842-.0276c.4616-.6304.8731-1.2952 1.226-1.9942a.076.076 0 00-.0416-.1057c-.6528-.2476-1.2743-.5495-1.8722-.8923a.077.077 0 01-.0076-.1277c.1258-.0943.2517-.1923.3718-.2914a.0743.0743 0 01.0776-.0105c3.9278 1.7933 8.18 1.7933 12.0614 0a.0739.0739 0 01.0785.0095c.1202.099.246.1981.3728.2924a.077.077 0 01-.0066.1276 12.2986 12.2986 0 01-1.873.8914.0766.0766 0 00-.0407.1067c.3604.698.7719 1.3628 1.225 1.9932a.076.076 0 00.0842.0286c1.961-.6067 3.9495-1.5219 6.0023-3.0294a.077.077 0 00.0313-.0552c.5004-5.177-.8382-9.6739-3.5485-13.6604a.061.061 0 00-.0312-.0286zM8.02 15.3312c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9555-2.4189 2.157-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.9555 2.4189-2.1569 2.4189zm7.9748 0c-1.1825 0-2.1569-1.0857-2.1569-2.419 0-1.3332.9554-2.4189 2.1569-2.4189 1.2108 0 2.1757 1.0952 2.1568 2.419 0 1.3332-.946 2.4189-2.1568 2.4189Z" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        </Canvas>
                    </Viewbox>
                </Button>
                <Button Command="{Binding OpenGitHubCommand}" Classes="headerLink"
                        ToolTip.Tip="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Link.GitHub]}"
                        AutomationProperties.Name="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Link.GitHub]}">
                    <!-- GitHub mark: Primer Octicons (MIT). -->
                    <Viewbox Width="22" Height="22" Stretch="Uniform">
                        <Canvas Width="24" Height="24">
                            <Path Data="M10.226 17.284c-2.965-.36-5.054-2.493-5.054-5.256 0-1.123.404-2.336 1.078-3.144-.292-.741-.247-2.314.09-2.965.898-.112 2.111.36 2.83 1.01.853-.269 1.752-.404 2.853-.404 1.1 0 1.999.135 2.807.382.696-.629 1.932-1.1 2.83-.988.315.606.36 2.179.067 2.942.72.854 1.101 2 1.101 3.167 0 2.763-2.089 4.852-5.098 5.234.763.494 1.28 1.572 1.28 2.807v2.336c0 .674.561 1.056 1.235.786 4.066-1.55 7.255-5.615 7.255-10.646C23.5 6.188 18.334 1 11.978 1 5.62 1 .5 6.188.5 12.545c0 4.986 3.167 9.12 7.435 10.669.606.225 1.19-.18 1.19-.786V20.63a2.9 2.9 0 0 1-1.078.224c-1.483 0-2.359-.808-2.987-2.313-.247-.607-.517-.966-1.034-1.033-.27-.023-.359-.135-.359-.27 0-.27.45-.471.898-.471.652 0 1.213.404 1.797 1.235.45.651.921.943 1.483.943.561 0 .92-.202 1.437-.719.382-.381.674-.718.944-.943" Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"/>
                        </Canvas>
                    </Viewbox>
                </Button>
            </StackPanel>
        </Grid>

        <!-- Row 1: Fixed Form Elements -->
        <StackPanel Grid.Row="1" Spacing="25" Margin="0,0,0,25">
            <StackPanel Spacing="15">
                <StackPanel Spacing="8">
                    <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Label.GamePath]}" FontWeight="SemiBold" FontSize="14"/>
                    <Border BorderBrush="{DynamicResource SystemControlForegroundBaseLowBrush}"
                            BorderThickness="1" CornerRadius="4" Height="38"
                            Background="{DynamicResource SystemControlBackgroundAltHighBrush}">
                        <Grid ColumnDefinitions="*, Auto">
                            <TextBox Grid.Column="0" Text="{Binding GamePath}" 
                                     IsReadOnly="{Binding IsGamePathValid}"
                                     Watermark="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Status.GamePathNotFound]}" 
                                     BorderThickness="0"
                                     Background="Transparent"
                                     VerticalAlignment="Stretch"
                                     VerticalContentAlignment="Center"
                                     Margin="5,0,0,0"/>
                            
                            <Button Grid.Column="1" Command="{Binding BrowseFolderCommand}" 
                                    Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Button.Browse]}" 
                                    IsEnabled="{Binding CanGlobalInteract}"
                                    VerticalAlignment="Stretch"
                                    VerticalContentAlignment="Center"
                                    Padding="15,0"
                                    BorderThickness="0"
                                    Background="Transparent"
                                    CornerRadius="0,4,4,0"/>
                            
                            <Border Grid.Column="1" HorizontalAlignment="Left" Width="1" 
                                    Background="{DynamicResource SystemControlForegroundBaseLowBrush}"
                                    Margin="0,5"/>
                        </Grid>
                    </Border>
                </StackPanel>

                <Grid ColumnDefinitions="*, 20, *" IsEnabled="{Binding CanInteract}">
                    <StackPanel Grid.Column="0" Spacing="8">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Label.Branch]}" FontWeight="SemiBold" FontSize="14"/>
                        <ComboBox SelectedIndex="{Binding SelectedBranch}" HorizontalAlignment="Stretch" Height="35">
                            <ComboBoxItem>Stable</ComboBoxItem>
                            <ComboBoxItem>Staging</ComboBoxItem>
                        </ComboBox>
                    </StackPanel>
                    
                    <StackPanel Grid.Column="2" Spacing="8">
                        <TextBlock Text="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Label.Language]}" FontWeight="SemiBold" FontSize="14"/>
                        <ComboBox HorizontalAlignment="Stretch" Height="35" 
                                  ItemsSource="{Binding TargetLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding Converter={StaticResource LanguageDisplayConverter}}"/>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </StackPanel>
                </Grid>
            </StackPanel>

            <Separator Height="1" Background="{DynamicResource SystemControlForegroundBaseLowBrush}" Margin="0,5"/>

            <Grid ColumnDefinitions="*,15,*,15,*" Margin="0,5">
                <Button Grid.Column="0" Command="{Binding OpenCoverageCommand}" 
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Button.Coverage]}" HorizontalAlignment="Stretch" Height="45"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        CornerRadius="6" IsEnabled="{Binding CanInteract}"/>

                <Button Grid.Column="2" Command="{Binding RestoreCommand}" 
                        Content="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Button.Restore]}" HorizontalAlignment="Stretch" Height="45"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        CornerRadius="6" IsEnabled="{Binding CanInteract}"/>

                <Button Grid.Column="4" Command="{Binding InjectCommand}" 
                        HorizontalAlignment="Stretch" Height="45"
                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                        Foreground="White" FontWeight="Bold"
                        CornerRadius="6"
                        IsEnabled="{Binding CanInjectOrCancel}"
                        Classes.injecting="{Binding IsInjecting}"
                        Classes.committing="{Binding IsCommitting}">
                    <Button.Styles>
                        <Style Selector="Button">
                            <Setter Property="Content" Value="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Button.Inject]}"/>
                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
                        </Style>
                        <Style Selector="Button.injecting">
                            <Setter Property="Content" Value="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Button.Cancel]}"/>
                            <Setter Property="Background" Value="#D32F2F"/>
                        </Style>
                        <Style Selector="Button.committing">
                            <Setter Property="Content" Value="{Binding Source={x:Static services:LocalizationService.Instance}, Path=[Button.Committing]}"/>
                            <Setter Property="Background" Value="{DynamicResource SystemControlBackgroundAccentBrush}"/>
                        </Style>
                    </Button.Styles>
                </Button>
            </Grid>
        </StackPanel>

        <!-- Row 2: Status Bar and Expand Button -->
        <Grid Grid.Row="2" ColumnDefinitions="*, Auto">
            <StackPanel Grid.Column="0" Spacing="5" VerticalAlignment="Center">
                 <Grid ColumnDefinitions="*, Auto">
                    <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" 
                               Foreground="#333333" FontWeight="SemiBold" FontSize="14"
                               TextTrimming="CharacterEllipsis"/>
                    
                    <TextBlock Grid.Column="1" Text="{Binding Progress, StringFormat='{}{0:0}%'}" 
                               Foreground="#666666" Margin="10,0,0,0"
                               IsVisible="{Binding !IsIndeterminate}"/>
                </Grid>
                <ProgressBar Height="4" 
                             Foreground="{Binding HasFailed, Converter={StaticResource ProgressColorConverter}}"
                             Background="#333333"
                             Minimum="0" Maximum="100" 
                             Value="{Binding Progress}"
                             IsIndeterminate="{Binding IsIndeterminate}"/>
            </StackPanel>

            <ToggleButton Grid.Column="1" x:Name="LogToggle"
                          IsChecked="{Binding IsLogExpanded}"
                          Margin="15,0,0,0" Width="30" Height="30"
                          CornerRadius="15" Background="Transparent"
                          BorderThickness="0">
                <Path Data="M7.41,8.58L12,13.17L16.59,8.58L18,10L12,16L6,10L7.41,8.58Z" 
                      Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                      Stretch="Uniform" 
                      Width="12" Height="12"/>
            </ToggleButton>
        </Grid>

        <!-- Row 3: Collapsible Log Area -->
        <Border Grid.Row="3" Background="#1E1E1E" CornerRadius="8" Padding="15" Margin="0,15,0,0"
                IsVisible="{Binding IsLogExpanded}">
            <TextBox x:Name="LogTextBox"
                     Text="{Binding LogText}" 
                     IsReadOnly="True"
                     TextWrapping="NoWrap"
                     AcceptsReturn="True"
                     Height="200"
                     VerticalAlignment="Stretch"
                     Foreground="#CCCCCC" 
                     FontFamily="Consolas, Cascadia Code, Monospace" 
                     FontSize="12"
                     ScrollViewer.HorizontalScrollBarVisibility="Auto"
                     ScrollViewer.VerticalScrollBarVisibility="Auto"
                     SelectionBrush="{DynamicResource SystemAccentColor}"
                     BorderThickness="0"
                     FocusAdorner="{x:Null}">
                <TextBox.Styles>
                    <Style Selector="TextBox">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="BorderBrush" Value="Transparent"/>
                    </Style>
                </TextBox.Styles>
            </TextBox>
        </Border>
    </Grid>
</Window>
